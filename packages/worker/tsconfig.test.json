{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "node"],
    "baseUrl": "../..",
    "paths": {
      "@maioun/shared": ["./packages/shared/src/index.ts"],
      "@maioun/collector": ["./packages/collector/src/index.ts"],
      "@maioun/collector/server/routes": ["./packages/collector/src/server/routes.ts"],
      "@maioun/collector/notify/mailer": ["./packages/collector/src/notify/mailer.ts"],
      "@maioun/collector/notify/email-theme": ["./packages/collector/src/notify/email-theme.ts"],
      "@maioun/collector/contact/agency-form": ["./packages/collector/src/contact/agency-form.ts"]
    },
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts"],
  "references": []
}
