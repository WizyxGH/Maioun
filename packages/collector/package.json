{
  "name": "@maioun/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collecte, normalisation, dédoublonnage, scoring et persistance des annonces.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server/routes": {
      "types": "./dist/server/routes.d.ts",
      "default": "./dist/server/routes.js"
    },
    "./db/quota": {
      "types": "./dist/db/quota.d.ts",
      "default": "./dist/db/quota.js"
    },
    "./notify/mailer": {
      "types": "./dist/notify/mailer.d.ts",
      "default": "./dist/notify/mailer.js"
    },
    "./notify/email-theme": {
      "types": "./dist/notify/email-theme.d.ts",
      "default": "./dist/notify/email-theme.js"
    },
    "./contact/agency-form": {
      "types": "./dist/contact/agency-form.d.ts",
      "default": "./dist/contact/agency-form.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "collect": "tsc --build && node dist/cli/collect.js",
    "draft": "tsc --build && node dist/cli/draft.js",
    "email:test": "tsc --build && node dist/cli/email-test.js",
    "reprocess": "tsc --build && node dist/cli/reprocess.js",
    "db:migrate": "tsc --build && node dist/cli/migrate.js",
    "db:dump": "tsc --build && node dist/cli/dump.js",
    "audit:data": "tsc --build && node dist/cli/audit.js",
    "contact:bep": "tsc --build && node --env-file=../../.env dist/cli/contact-bep.js",
    "serve": "tsc --build && node dist/cli/serve.js",
    "local": "tsc --build && node dist/cli/local.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@maioun/shared": "workspace:*",
    "cheerio": "^1.2.0",
    "imapflow": "^1.7.3",
    "mailparser": "^3.9.20",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@libsql/sync": "npm:@libsql/client@^0.18.0",
    "@types/mailparser": "^3.4.6",
    "@types/web-push": "^3.6.4"
  }
}
