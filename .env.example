# Maïoun (dépôt Maïoun) — configuration privée de la MACHINE QUI COLLECTE.
#
# Copier vers `.env` et renseigner. `.env` est ignoré par git, jamais committé.
# Toutes les valeurs ci-dessous sont fictives.
#
# CE FICHIER NE CONFIGURE PAS LE SITE. Le site publié ne lit rien d'ici : il
# parle au Worker, dont les secrets se déposent avec `wrangler secret put`
# (voir plus bas). Ce qui suit ne concerne que la collecte.

# --- Accès abonnés (§6, §26) -------------------------------------------------
#
# ILS NE SE CONFIGURENT PLUS ICI. Un abonnement à une source payante est payé à
# titre PERSONNEL : le ranger dans ce fichier le réservait à qui tient la
# machine, et un second compte ne pouvait ni s'en servir ni déclarer le sien.
# Chacun pose le sien dans Paramètres → Accès abonnés, où il est chiffré.
#
# CETTE CLÉ EST CE QUI PERMET DE LES RELIRE. Le Worker chiffre, le collecteur
# déchiffre : les deux doivent porter EXACTEMENT la même valeur, sans quoi les
# accès déclarés deviennent illisibles et les sources concernées se taisent.
# Elle se tire au hasard, une fois :
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Absente côté Worker, l'écran refuse d'enregistrer plutôt que de ranger un mot
# de passe en clair (§17).
CREDENTIALS_KEY=

# --- BEP Logement — amorçage seulement --------------------------------------
# Espace abonné http://abonnes.beplogement.com.
#
# NE SERT PLUS QU'AU DÉMARRAGE : une machine qui collecte avant que quiconque
# ait ouvert l'écran. Un accès déclaré depuis le site l'emporte toujours.
# Les annonces ainsi révélées entrent en base pour tout le monde — c'est le
# choix assumé d'une collecte unique et partagée.
BEP_SUBSCRIBER_USER=
BEP_SUBSCRIBER_PASSWORD=

# --- Collecte (§10) ---------------------------------------------------------
# User-Agent honnête : le projet ne se fait jamais passer pour un navigateur.
COLLECTOR_USER_AGENT=MaiounBot/0.1 (+https://github.com/example-user/rentfinder)
# Backfill (§8) : descend dans l'historique. À `true` seulement à dessein.
# INTERRUPTEUR GÉNÉRAL de l'envoi automatique de candidatures (§23). Il reste à
# `false` : aucun message ne part sans un geste explicite. La mécanique de
# garde-fous existe déjà (plafonds, historique, sources autorisées) et attend
# cet interrupteur — le retirer reviendrait à retirer le frein avant la voiture.
AUTO_CONTACT_ENABLED=false

# --- Profil locataire et adresses de référence : PLUS ICI ---------------------
#
# Ils se règlent depuis le site — Paramètres → Profil locataire, et Paramètres →
# Adresses de référence — et vivent en base, donc par compte, en suivant d’un
# appareil à l’autre.
#
# Ils ont eu un second domicile ici, et c’est un piège qui ne se voit pas : qui
# corrigeait son téléphone ou ses revenus dans l’application obtenait des
# brouillons portant les ANCIENNES valeurs, et ces brouillons-là partent à des
# agences. Aucune erreur ne pouvait le signaler — ce fichier était rempli, la
# commande n’avait aucune raison de se plaindre.
#
# Les coordonnées de référence révèlent en outre un domicile et un lieu de
# travail : le seul endroit où elles doivent vivre est celui que l’utilisateur
# contrôle depuis son écran.

# Sans jeton Navitia, la durée est estimée ; avec, elle est réelle et calculée
# pour arriver à l'heure ci-dessous. Le plafond de trajet se règle DEPUIS LE
# SITE (Trier et filtrer), comme les autres critères.
# NAVITIA_TOKEN=
WORK_ARRIVAL_TIME=09:00

# --- Import des alertes e-mail (§6, §10) ------------------------------------
# Voie conforme pour Leboncoin/SeLoger : le portail envoie ses annonces par
# e-mail, Maïoun les lit dans VOTRE boîte en lecture seule. Gmail : activer
# IMAP et créer un MOT DE PASSE D'APPLICATION.
#
# MULTI-COMPTE : par TRANSFERT, et non en lisant la boîte de chacun. La boîte
# configurée ici est celle du PROJET, pas celle d'un utilisateur : chaque compte
# reçoit une adresse `alertes+<jeton>@...` (voir ALERT_ADDRESS_TEMPLATE) et y
# fait suivre ses alertes depuis sa propre boîte, par une règle qu'il pose et
# retire lui-même. Nous ne détenons aucun de ses identifiants.
#
# OAuth a été écarté le 2026-09-05 : il ne couvre que Gmail et Outlook, quand
# les boîtes visées sont chez laposte.net, Orange ou Free, et il exige une
# vérification annuelle payante de Google pour lire des messages — sans quoi
# les jetons expirent tous les sept jours.
#
# Seuls les e-mails PROVENANT des portails sont lus, jamais les autres (§26).
# IMAP_USER=prenom.nom@example.invalid
# IMAP_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX

# Adresse de transfert montrée à chaque compte, `{token}` étant remplacé par
# son jeton. La boîte doit accepter le sous-adressage `+` (Gmail le fait).
# Absente : l'écran le dit au lieu d'inventer une adresse (§17).
# ALERT_ADDRESS_TEMPLATE=alertes+{token}@example.invalid

# --- Journal et liens des notifications -------------------------------------
# Adresse du site publié, utilisée pour que chaque notification renvoie à la
# BONNE fiche. Par défaut, l'adresse GitHub Pages du projet ; à changer le jour
# où le site prend son propre domaine.
# SITE_URL=https://exemple.github.io/Maioun/app/
# Sortie narrée par défaut (phrases lisibles) ; `json` pour l'analyser.
# LOG_FORMAT=json

# --- Base de données --------------------------------------------------------
# Par défaut : fichier SQLite local créé automatiquement, rien à configurer.
# `DATABASE_URL` ne sert qu'à pointer un AUTRE fichier local ; les tests
# utilisent une base en mémoire — ne jamais viser la base de travail (§52).
# DATABASE_URL=file:./data/local.db
# TEST_DATABASE_URL=file:./data/test.db

# --- Mode cloud (optionnel, §28) --------------------------------------------
# Base Turso privée, lue par l'interface hébergée. Voir docs/deployment.md.
# TURSO_DATABASE_URL=libsql://exemple-base.turso.io
# TURSO_AUTH_TOKEN=

# --- Worker Cloudflare (§28) ------------------------------------------------
# L'API du site publié. SES SECRETS NE VIVENT PAS ICI : ils se déposent une
# fois avec `wrangler secret put`, du côté de la plateforme, précisément pour
# que le jeton Turso ne redescende jamais dans un navigateur (§26).
#
#   npx wrangler secret put TURSO_DATABASE_URL
#   npx wrangler secret put TURSO_AUTH_TOKEN
#   npx wrangler secret put SESSION_SECRET     # longue chaîne aléatoire
#
# `TURSO_*` ci-dessus restent utiles à CETTE machine : la collecte et la
# création de comptes (`user:add`) écrivent en base directement.

# --- Notifications Web Push (§29) -------------------------------------------
# Alerte téléphone rangé, émise par la collecte planifiée — aucun serveur en
# plus. Générer une paire : `npx web-push generate-vapid-keys`.
# La clé PUBLIQUE part dans le site (ce n'est pas un secret) ; la PRIVÉE reste
# ici et dans les secrets GitHub.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:vous@example.invalid
